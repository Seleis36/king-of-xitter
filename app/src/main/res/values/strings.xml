    <!-- c01 Doomscroll Drip (Acid Attack) -->
    <string name="card_c01_name">Doomscroll Drip</string>
    <string name="card_c01_rules">Deal 1 extra unfollow each turn, even if you roll no tweets.</string>
    <string name="card_c01_flavour">The algorithm knows what you need. It\'s more.</string>

    <!-- c02 Lobbyist (Alien Metabolism) -->
    <string name="card_c02_name">Lobbyist</string>
    <string name="card_c02_rules">Power-ups cost 10 fewer characters.</string>
    <string name="card_c02_flavour">He doesn\'t work for you. He works adjacent to you.</string>

    <!-- c03 Alpha Poster (Alpha Monster) -->
    <string name="card_c03_name">Alpha Poster</string>
    <string name="card_c03_rules">+1 mandate when you tweet at someone.</string>
    <string name="card_c03_flavour">Every ratio is a mandate. Every mandate is a message.</string>

    <!-- c04 Thick Skin PR (Armor Plating) -->
    <string name="card_c04_name">Thick Skin PR</string>
    <string name="card_c04_rules">Ignore hits of exactly 1 unfollow.</string>
    <string name="card_c04_flavour">Our client has no further comment on the allegations.</string>

    <!-- c05 Lurker (Background Dweller) -->
    <string name="card_c05_name">Lurker</string>
    <string name="card_c05_rules">You may always reroll any 3s.</string>
    <string name="card_c05_flavour">Reads everything. Posts nothing. Knows everything.</string>

    <!-- c06 Home Turf (Burrowing) -->
    <string name="card_c06_name">Home Turf</string>
    <string name="card_c06_rules">+1 unfollow while on Xitter. When you log off, the new Main Character loses 1M followers.</string>
    <string name="card_c06_flavour">Your corner of the internet. Trespassers get ratio\'d.</string>

    <!-- c07 Parody Account (Camouflage) -->
    <string name="card_c07_name">Parody Account</string>
    <string name="card_c07_rules">When hit, roll 1 die per unfollow; each like cancels one.</string>
    <string name="card_c07_flavour">For entertainment purposes only. Results may vary.</string>

    <!-- c08 Full Bingo (Complete Destruction) -->
    <string name="card_c08_name">Full Bingo</string>
    <string name="card_c08_rules">Rolling 1-2-3-like-tweet-characters: +9 mandates.</string>
    <string name="card_c08_flavour">The universe aligned. You screenshot this.</string>

    <!-- c09 Press Office (Dedicated News Team) -->
    <string name="card_c09_name">Press Office</string>
    <string name="card_c09_rules">+1 mandate per power-up bought.</string>
    <string name="card_c09_flavour">Every transaction is an opportunity for a press release.</string>

    <!-- c10 Gravedancer (Eater of the Dead) -->
    <string name="card_c10_name">Gravedancer</string>
    <string name="card_c10_rules">+3 mandates whenever a leader is suspended.</string>
    <string name="card_c10_flavour">Post-suspension tweet: "I barely even knew them."</string>

    <!-- c11 Drafts Folder (Energy Hoarder) -->
    <string name="card_c11_name">Drafts Folder</string>
    <string name="card_c11_rules">At end of turn, +1 mandate per 60 characters you hold.</string>
    <string name="card_c11_flavour">Thirty-seven unsent tweets. One will be perfect.</string>

    <!-- c12 Bot Farm (Even Bigger) -->
    <string name="card_c12_name">Bot Farm</string>
    <string name="card_c12_rules">+2M max followers; gain 2M now.</string>
    <string name="card_c12_flavour">Each account is totally real. We have their profiles.</string>

    <!-- c13 Second Phone (Extra Head ×2) -->
    <string name="card_c13_name">Second Phone</string>
    <string name="card_c13_rules">+1 die.</string>
    <string name="card_c13_flavour">One for the posts. One for the apologies.</string>

    <!-- c15 Quote Tweet (Fire Breathing) -->
    <string name="card_c15_name">Quote Tweet</string>
    <string name="card_c15_rules">Your neighbours lose 1M extra followers when you deal damage.</string>
    <string name="card_c15_flavour">Adding context. Specifically: you\'re finished.</string>

    <!-- c16 Pinned Tweet (Freeze Time) -->
    <string name="card_c16_name">Pinned Tweet</string>
    <string name="card_c16_rules">On 1-1-1, take another turn with one fewer die.</string>
    <string name="card_c16_flavour">This message is permanently at the top of the timeline.</string>

    <!-- c17 Influencer Deal (Friend of Children) -->
    <string name="card_c17_name">Influencer Deal</string>
    <string name="card_c17_rules">+10 extra characters whenever you gain characters.</string>
    <string name="card_c17_flavour">Use code MANDATE for 10% off your first order.</string>

    <!-- c18 Speechwriter (Giant Brain) -->
    <string name="card_c18_name">Speechwriter</string>
    <string name="card_c18_rules">+1 reroll each turn.</string>
    <string name="card_c18_flavour">The words are yours. The ideas are negotiable.</string>

    <!-- c19 Old Guard (Gourmet) -->
    <string name="card_c19_name">Old Guard</string>
    <string name="card_c19_rules">1-1-1 scores +2 extra mandates.</string>
    <string name="card_c19_flavour">The classics, for a reason.</string>

    <!-- c20 Retweet for Retweet (Healing Ray) -->
    <string name="card_c20_name">Retweet for Retweet</string>
    <string name="card_c20_rules">Your likes can heal others; they pay you 20 characters per 1M.</string>
    <string name="card_c20_flavour">Engagement is a currency. Invoice attached.</string>

    <!-- c21 Peace Summit (Herbivore) -->
    <string name="card_c21_name">Peace Summit</string>
    <string name="card_c21_rules">+1 mandate on a turn where you hit nobody.</string>
    <string name="card_c21_flavour">An historic handshake. No photos, please.</string>

    <!-- c22 Poll Rigger (Herd Culler) -->
    <string name="card_c22_name">Poll Rigger</string>
    <string name="card_c22_rules">Once per turn, change one die to a 1.</string>
    <string name="card_c22_flavour">97% of respondents agree: this is fine.</string>

    <!-- c23 Burner Account (It Has a Child) -->
    <string name="card_c23_name">Burner Account</string>
    <string name="card_c23_rules">When suspended: discard all cards, lose all mandates, return with 10M followers.</string>
    <string name="card_c23_flavour">New account. Fresh start. Same enemies.</string>

